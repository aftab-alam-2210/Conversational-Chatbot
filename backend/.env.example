# Server Configuration
PORT=5003
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated exact origins allowed to request browser Live API credentials.
# Add the production website origin when the widget is embedded on another domain.
LIVE_ALLOWED_ORIGINS=http://localhost:5173

# Official website knowledge source; ingestion is same-origin and respects robots.txt.
KB_WEBSITE_URL=https://vvntsequor.in/

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vvnt_sequor_ai

# OpenAI Configuration
OPENAI_API_KEYS=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenRouter fallback (comma-separated keys supported)
OPENROUTER_API_KEYS=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=vvnt-sequor-knowledge
PINECONE_ENVIRONMENT=us-east-1

# VVnT SeQuor Enterprise Constants
COMPANY_NAME="VVnT SeQuor"
SUPPORT_EMAIL="contact@vvntsequor.com"
SALES_EMAIL="sales@vvntsequor.com"

# Gemini Live Voice Mode (permanent key stays on the backend)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede
LIVE_VOICE_ENABLED=true
